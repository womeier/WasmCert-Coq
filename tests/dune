(mdx
  (deps 
     (package coq-wasm)
      (glob_files *.wasm))
)

(rule
  (alias runtest)
  (deps ../run_wast.sh (glob_files conformance/*.wast))
  (action
    (setenv EXE %{exe:../src/wasm_coq_interpreter.exe}
      (run bash ../run_wast.sh conformance))))

(rule
  (alias runtest)
  (deps ../run_wast.sh test_wast_runner.py)
  (action (run python3 test_wast_runner.py ../run_wast.sh)))

(rule
 (alias runtest)
 (deps run_wast_tests.sh ../run_wast.sh)
 (action (run bash %{dep:run_wast_tests.sh} %{dep:../run_wast.sh})))

(rule
 (alias runtest)
 (deps function_references_binary.py)
 (action
   (run python3 %{dep:function_references_binary.py}
    %{exe:../src/wasm_coq_interpreter.exe})))

(test
  (name addressing_extracted)
  (modules addressing_extracted)
  (libraries wasmcert_extracted parray zarith))

(rule
 (alias runtest)
 (deps run_wast_test.sh ../run_wast.sh)
 (action (run bash %{dep:run_wast_test.sh} %{dep:../run_wast.sh})))

(rule
 (target multi_memory_binary.wast)
 (deps multi_memory_binary.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:multi_memory_binary.py}))))

(rule
 (alias runtest)
 (deps multi_memory_binary.wast ../run_wast.sh)
 (action
  (setenv EXE %{exe:../src/wasm_coq_interpreter.exe}
   (setenv JOBS 1
    (run bash %{dep:../run_wast.sh} . multi_memory_binary)))))

