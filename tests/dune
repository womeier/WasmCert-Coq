(mdx
  (deps 
     (package coq-wasm)
      (glob_files *.wasm))
)

(test
  (name addressing_extracted)
  (modules addressing_extracted)
   (libraries wasmcert_extracted parray zarith))

(test
 (name wast_binary_script_test)
 (modules wast_binary_script_test)
 (libraries wasmcert_extracted))

(rule
 (target binary_script_definitions.wast)
 (deps binary_script_definitions.py)
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:binary_script_definitions.py}))))

(rule
 (alias runtest)
 (deps binary_script_definitions.wast ../run_wast.sh)
 (action
  (setenv EXE %{exe:../src/wasm_coq_interpreter.exe}
   (setenv JOBS 1
    (run bash %{dep:../run_wast.sh} . binary_script_definitions)))))

(rule
 (alias runtest)
 (deps binary_script_definitions.py binary_script_definitions_test.sh ../run_wast.sh)
 (action
  (run bash %{dep:binary_script_definitions_test.sh}
   %{dep:binary_script_definitions.py} %{dep:../run_wast.sh}
   %{exe:../src/wasm_coq_interpreter.exe})))

