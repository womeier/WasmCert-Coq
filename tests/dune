(rule
 (target section_framing_binary.wast)
 (deps section_framing_binary.py)
 (action
  (run python3 %{dep:section_framing_binary.py} %{target})))

(rule
 (alias runtest)
 (deps section_framing_binary.wast ../run_wast.sh)
 (action
  (setenv EXE %{exe:../src/wasm_coq_interpreter.exe}
   (setenv JOBS 1
    (run bash %{dep:../run_wast.sh} . section_framing_binary)))))

